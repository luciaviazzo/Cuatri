# ---- Backend (backend/.env) ----
# Conexión a Postgres. Acepta postgres://, postgresql:// o postgresql+psycopg://
# (se normaliza automáticamente). En Render se inyecta desde la base gestionada.
DATABASE_URL=postgresql+psycopg://cuatri:cuatri@localhost:5432/cuatri
# Orígenes permitidos por CORS, separados por coma. En prod: la URL de Vercel.
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=local
# Tamaño máximo (en bytes) del PDF/XLS de plan de estudios. Por defecto 10 MB.
MAX_UPLOAD_BYTES=10485760

# ---- Frontend (frontend/.env) ----
# URL pública del backend. En Vercel se configura como variable de entorno.
VITE_API_URL=http://localhost:8000
